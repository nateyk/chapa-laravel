CHAPA_SECRET_KEY=CHAPA_TEST_your_private_key
CHAPA_PUBLIC_KEY=CHAPA_TEST_your_public_key
CHAPA_WEBHOOK_SECRET=replace_with_strong_webhook_secret
CHAPA_MODE=test
CHAPA_WEBHOOK_INTEGRATION=default
CHAPA_WEBHOOK_MAX_ATTEMPTS=8

# Optional, disabled Transfer Approval URL (requires genuine Chapa test-mode signature verification)
CHAPA_TRANSFER_APPROVAL_ENABLED=false
CHAPA_TRANSFER_APPROVAL_MODE=test
CHAPA_TRANSFER_APPROVAL_INTEGRATION=default
CHAPA_TRANSFER_APPROVAL_SECRET=replace_with_a_separate_strong_approval_secret
