#!/usr/bin/env php
<?php

declare(strict_types=1);

// Runnable directly from a repository clone, without mandatory Composer installation.
$autoload = __DIR__.'/../vendor/autoload.php';
if (!is_file($autoload)) {
    $autoload = dirname(__DIR__, 3).'/autoload.php'; // Installed under vendor/<owner>/<package>/bin.
}
if (is_file($autoload)) {
    require $autoload;
} else {
    spl_autoload_register(static function (string $name): void {
        $prefix = 'Nateyk\\Chapa\\';
        if (!str_starts_with($name, $prefix)) {
            return;
        }
        $filename = __DIR__.'/../src/'.str_replace('\\', '/', substr($name, strlen($prefix))).'.php';
        if (is_file($filename)) {
            require $filename;
        }
    });
}

use Nateyk\Chapa\Cli\TestConsole;

$arguments = array_slice($argv, 1);
if ($arguments === [] || in_array($arguments[0], ['--help', '-h', 'help'], true)) {
    exit((new TestConsole())->run(['--help']));
}
if ($arguments[0] === 'simulate') {
    $options = array_slice($arguments, 1);
    if (count($options) > 2 || count(array_filter($options, static fn ($arg): bool => $arg === '--json')) > 1) {
        fwrite(STDERR, "Usage: php bin/chapa simulate [all|direct|inline|states|webhooks] [--json]\n");
        exit(2);
    }
    $json = in_array('--json', $options, true);
    $names = array_values(array_filter($options, static fn (string $arg): bool => $arg !== '--json'));
    $name = $names[0] ?? 'all';
    if (count($names) > 1 || !in_array($name, ['all', 'direct', 'inline', 'states', 'webhooks'], true)) {
        fwrite(STDERR, "Unknown simulation. Use: all, direct, inline, states or webhooks.\n");
        exit(2);
    }
    $report = (new \Nateyk\Chapa\Cli\OfflineScenarios())->run($name);
    fwrite(STDOUT, ($json ? $report->toJson() : $report->toText())."\n");
    exit($report->successful() ? 0 : 1);
}
if ($arguments[0] === 'doctor') {
    exit((new TestConsole())->run(['doctor']));
}
if ($arguments[0] !== 'test') {
    fwrite(STDERR, "Unknown command. Run: php bin/chapa --help\n");
    exit(2);
}
exit((new TestConsole())->run(array_slice($arguments, 1)));
